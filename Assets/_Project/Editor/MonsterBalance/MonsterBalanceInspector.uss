.monster-balance {
    padding: 8px;
}
.balance-title {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}
.balance-results {
    background-color: rgba(30, 110, 120, 0.16);
    padding: 10px;
    margin-top: 10px;
    margin-bottom: 10px;
    border-left-width: 3px;
    border-left-color: rgb(73, 174, 172);
}
.balance-result-row {
    margin-bottom: 7px;
}
.balance-result-key {
    -unity-font-style: bold;
}
.balance-result-value {
    white-space: normal;
}
.balance-source {
    margin-top: 8px;
    margin-bottom: 6px;
}
.balance-path {
    white-space: normal;
    font-size: 10px;
    margin-bottom: 5px;
}
.balance-hidden {
    display: none;
}
.direction-frame {
    margin-top: 8px;
    padding: 8px;
    background-color: rgba(90, 105, 60, 0.12);
}
.direction-preview {
    height: 110px;
    margin-top: 6px;
}
